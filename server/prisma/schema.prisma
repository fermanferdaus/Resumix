datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id           BigInt         @id @default(autoincrement())
  publicId     String         @unique @map("public_id")
  email        String         @unique
  fullName     String?        @map("full_name")
  phone        String?        @map("phone")
  dob          DateTime?      @map("dob")
  domicile     String?        @map("domicile")
  password     String?
  isVerified   Boolean        @default(false) @map("is_verified")
  googleId     String?        @unique @map("google_id")
  avatarUrl    String?        @map("avatar_url")
  role         String         @default("USER") @map("role")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  
  refreshTokens RefreshToken[]
  resumes       Resume[]
  loginLogs     LoginLog[]

  @@map("users")
}

model Resume {
  id         BigInt   @id @default(autoincrement())
  publicId   String   @unique @map("public_id")
  userId     BigInt   @map("user_id")
  title      String   @default("Resume Tanpa Judul")
  targetRole String?  @map("target_role")
  data       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("resumes")
}

model Otp {
  id        BigInt   @id @default(autoincrement())
  publicId  String   @unique @map("public_id")
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("otps")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  publicId  String   @unique @map("public_id")
  userId    BigInt   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        BigInt   @id @default(autoincrement())
  publicId  String   @unique @map("public_id")
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, token])
  @@map("password_resets")
}

model LoginLog {
  id          BigInt   @id @default(autoincrement())
  publicId    String   @unique @map("public_id")
  userId      BigInt?  @map("user_id")
  email       String
  ipAddress   String   @map("ip_address")
  userAgent   String?  @map("user_agent")
  device      String?  @map("device")
  browser     String?  @map("browser")
  location    String?  @map("location")
  country     String?  @map("country")
  city        String?  @map("city")
  status      String   @map("status") // SUCCESS, FAILED, SUSPICIOUS
  loginMethod String   @map("login_method") // PASSWORD, OTP, GOOGLE
  reason      String?  @map("reason")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_logs")
}
