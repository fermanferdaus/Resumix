
#  APPLICATION CONFIGURATION
PORT=3000
SERVER_PORT=3000
APP_VERSION=1.0
NODE_ENV=development
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

#  DATABASE (PostgreSQL / Prisma)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=namaku123_
DB_NAME=resumix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=namaku123_
POSTGRES_DB=resumix
DATABASE_URL=postgresql://postgres:namaku123_@localhost:5432/resumix?schema=public

#  AUTHENTICATION (JWT)
JWT_ACCESS_SECRET=resumix_jwt_access_super_secret_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=resumix_jwt_refresh_super_secret_key_2026
JWT_REFRESH_EXPIRES_IN=12h

#  CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

#  GOOGLE OAUTH 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
ENABLE_AUTH_MOCK=false

#  OTP CONFIGURATION
OTP_EXPIRES_MINUTES=5

#  SMTP / EMAIL SERVICE (Nodemailer)
# Contoh Gmail: SMTP_HOST=smtp.gmail.com | SMTP_PORT=587 | SMTP_SECURE=false | SMTP_USER=your_email@gmail.com | SMTP_PASS=your_app_password
# Contoh Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io | SMTP_PORT=2525
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=noreply@resumix.app
MAIL_FROM_NAME="Resumix No-Reply"
MAIL_REPLY_TO=noreply@resumix.app
MAIL_LOGO_URL=http://localhost:5173/logo.png
 
#  ADMIN SEED CONFIGURATION
ADMIN_SEED_NAME="Name of Admin"
ADMIN_SEED_EMAIL=email@gmail.com
ADMIN_SEED_PASSWORD=your_admin_password
